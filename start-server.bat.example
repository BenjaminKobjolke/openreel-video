@echo off
rem Starts the OpenReel sync server (apps/sync-server) for desktop + phone.
rem Restart while running: tools\restart.bat server
rem Builds the web app into apps\sync-server\web-dist on first run, or when called as: start-server.bat build
rem Copy this file to start-server.bat (gitignored) and set your own token there.
rem Enter the same token in Settings > Sync on each device.
cd /d "%~dp0"
set OPENREEL_SYNC_TOKEN=change-me
set OPENREEL_SYNC_PORT=5180
rem Keep the data outside any web server root so it cannot be served without the token.
set OPENREEL_SYNC_DATA=%USERPROFILE%\.openreel\sync-data
set OPENREEL_SYNC_WEB=%~dp0apps\sync-server\web-dist

if /i "%~1"=="build" goto build
if not exist "%OPENREEL_SYNC_WEB%\index.html" goto build
goto run

:build
call pnpm --filter @openreel/web exec vite build --outDir "%OPENREEL_SYNC_WEB%" --emptyOutDir
if errorlevel 1 exit /b 1

:run
echo Token: %OPENREEL_SYNC_TOKEN%
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0tools\supervise.ps1" server pnpm --filter @openreel/sync-server start
